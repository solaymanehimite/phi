{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/server", "sidecar": true, "args": [{ "validator": "\\d+" }] }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/server", "sidecar": true, "args": [{ "validator": "\\d+" }] }]
    }
  ]
}