{
  "name": "phi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,green \"bun run dev\" \"bun run dev:server\"",
    "build": "tsc && vite build",
    "build:sidecar": "bun build server/index.ts --compile --outfile src-tauri/binaries/server-x86_64-unknown-linux-gnu --target bun-linux-x64 && chmod +x src-tauri/binaries/server-x86_64-unknown-linux-gnu",
    "build:sidecar:pkg": "pkg server/index.ts --output src-tauri/binaries/server --targets node22-linux-x64 --compress Brotli && node scripts/bundle-sidecar.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "concurrently -n api,tauri -c green,magenta \"bun run dev:server\" \"tauri dev\""
  },
  "dependencies": {
    "@aicss/react": "^0.1.3",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-shell": "~2",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  }
}
