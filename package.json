{
  "name": "phi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "run pi agents in parallel.",
  "author": "Solaymane Himite sol.himite@gmail.com",
  "main": "dist-electron/main.cjs",
  "desktopName": "phi",
  "linux": {
    "syncDesktopName": true
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,green \"bun run dev\" \"bun run dev:server\"",
    "build": "tsc && vite build",
    "build:sidecar": "bun build server/index.ts --compile --outfile binaries/server-x86_64-unknown-linux-gnu --target bun-linux-x64 && chmod +x binaries/server-x86_64-unknown-linux-gnu",
    "build:sidecar:pkg": "pkg server/index.ts --output src-tauri/binaries/server --targets node22-linux-x64 --compress Brotli && node scripts/bundle-sidecar.js",
    "electron:build-main": "node scripts/build-electron.mjs",
    "electron:dev": "concurrently -n web,api,electron -c cyan,green,magenta \"vite\" \"bun --watch server/index.ts\" \"electron .\"",
    "electron:build": "tsc && vite build && bun run build:sidecar && node scripts/build-electron.mjs",
    "electron:dist": "electron-builder --config electron-builder.yml",
    "electron:dist-dir": "electron-builder --config electron-builder.yml --dir",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "bun scripts/lint.mjs"
  },
  "dependencies": {
    "@aicss/react": "^0.1.3",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@react-symbols/icons": "^1.4.1",
    "@tabler/icons-react": "^3.46.0",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^5.2.0"
  }
}
